#!/usr/bin/env bash

set -euo pipefail

# Load libraries
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
TAURUS_ROOT="$( cd -P "$( dirname "$SOURCE" )/.." && pwd )"

source "${TAURUS_ROOT}/lib/utils.sh"
source "${TAURUS_ROOT}/lib/config.sh"
source "${TAURUS_ROOT}/lib/filesystem.sh"
source "${TAURUS_ROOT}/lib/docker.sh"
source "${TAURUS_ROOT}/lib/hosts.sh"
source "${TAURUS_ROOT}/lib/ssh.sh"
source "${TAURUS_ROOT}/lib/database.sh"
source "${TAURUS_ROOT}/lib/magento.sh"

usage() {
    echo "Usage: taurus <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init      Initialize a new Magento project"
    echo "  start     Start project containers (stub)"
    echo "  stop      Stop project containers (stub)"
    echo "  restart   Restart project containers (stub)"
    echo "  ssh       Access project container via SSH"
    echo "  destroy   Remove project containers and configuration (stub)"
    echo ""
    echo "Usage for ssh:"
    echo "  taurus ssh <project-name>"
    echo ""
    echo "Options for init:"
    echo "  --project <name>    Project name (e.g., ogm2)"
    echo "  --repo <url>       Bitbucket repository URL"
    echo "  --php <version>    PHP version (8.2, 8.3, 8.4) (default: 8.3)"
    echo "  --db <path>        Path to database dump (.sql, .sql.gz, or .tar.gz) (required)"
    echo "  --media <path>     Path to media archive (.tar.gz)"
    echo "  --node-version <v> Node.js version to install (default: 24.19.0)"
}

cmd_init() {
    local project=""
    local repo=""
    local php=""
    local db_dump=""
    local media_archive=""
    local node_version=""

    while [[ $# -gt 0 ]]; do
        case $1 in
            --project) project="$2"; shift 2 ;;
            --repo) repo="$2"; shift 2 ;;
            --php) php="$2"; shift 2 ;;
            --db) db_dump="$2"; shift 2 ;;
            --media) media_archive="$2"; shift 2 ;;
            --node-version) node_version="$2"; shift 2 ;;
            *) exit_with_error "Unknown option: $1" ;;
        esac
    done

    # Validation (prompt interactively for anything missing)
    project=$(prompt_for_value "project" "$project" "Project code (e.g. 'my-project')")
    repo=$(prompt_for_value "repo" "$repo" "Repository URL (e.g. 'git@bitbucket.org:taurus_media/ohhg-m2.git')")
    db_dump=$(prompt_for_value "db" "$db_dump" "Path to database dump (.sql, .sql.gz, or .tar.gz)")
    db_dump=$(expand_path "$db_dump")
    media_archive=$(prompt_for_value "media" "$media_archive" "Path to media archive (.tar.gz, leave blank to skip)" false "")
    media_archive=$(expand_path "$media_archive")
    php=$(prompt_for_value "php" "$php" "PHP Version (e.g. '8.3')" false "8.3")
    node_version=$(prompt_for_value "node-version" "$node_version" "Node.js version" false "24.19.0")

    local domain="${project}.local"
    local project_path="${HOME}/Projects/${domain}"
    local container_name="$domain"
    local db_name="$project"
    local php_image
    php_image=$(get_php_image "$php")

    log_info "Initializing project: $project"
    
    # Project Directory
    ensure_project_dir "${HOME}/Projects"
    
    # Clone Repo
    clone_repo "$repo" "$project_path"
    
    # Hosts File
    update_hosts "$domain"
    
    # Start Container
    local pub_key_path
    if pub_key_path=$(get_public_key_path); then
        php_image=$(build_custom_ssh_image "$php_image" "$pub_key_path" "$project" "$php" "$node_version")
    fi

    log_info "IMAGE: $php_image"

    run_container "$container_name" "$php_image" "$project_path"

    # Vhosts Configuration
    configure_vhosts "$container_name" "$domain"
    
    # Database Configuration
    create_database "$container_name" "$db_name"
    if [[ -n "$db_dump" ]]; then
        import_database "$container_name" "$db_name" "$db_dump"
    fi
    
    # Media Import
    if [[ -n "$media_archive" ]]; then
        extract_media "$media_archive" "${project_path}/pub/media"
    fi
    
    # Composer
    run_composer_install "$container_name"
    
    # Magento env.php
    local db_password
    db_password=$(get_db_password "$container_name")
    generate_env_php "$container_name" "$db_name" "app" "$db_password" "http://${domain}/"
    
    # Symlinks
    # Inside container: ~/public -> ~/magento2/pub
    # Note: ~ in Hypernode container for 'app' user is /data/web
    create_container_symlink "$container_name" "/data/web/magento2/pub" "/data/web/public"
    
    # Magento Setup Commands
    run_magento_setup "$container_name"

    # Hyva Styles
    generate_hyva_styles "$container_name"

    # Base URL Configuration
    configure_magento_base_urls "$container_name" "$domain"
    
    log_success "Project $project initialized successfully!"
    echo "Domain: http://$domain"
    echo "Admin Panel: http://$domain/admin"
    echo "Local Path: $project_path"
    echo "Container: $container_name"
}

cmd_ssh() {
    local project="${1:-}"
    [[ -n "$project" ]] || exit_with_error "Usage: taurus ssh <project-name>"

    local domain="${project%.local}.local"
    local container_name="$domain"

    if ! container_is_running "$container_name"; then
        exit_with_error "Container '$container_name' is not running."
    fi

    log_info "Connecting to $container_name via SSH..."
    ssh "app@${domain}"
}

# Main Command Router
if [[ $# -lt 1 ]]; then
    usage
    exit 0
fi

COMMAND=$1
shift

case $COMMAND in
    init)
        cmd_init "$@"
        ;;
    ssh)
        cmd_ssh "$@"
        ;;
    start|stop|restart|destroy)
        log_info "Command '$COMMAND' is currently a stub."
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        exit_with_error "Unknown command: $COMMAND"
        ;;
esac
